<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/admin_bottom_nav"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="40dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Admin Panel"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Management"
                android:textColor="#888888"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <!-- Manage Events Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/btn_manage_events"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#121212"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">
                <RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent" android:paddingHorizontal="16dp">
                    <ImageView android:id="@+id/iv_ev_icon" android:layout_width="40dp" android:layout_height="40dp" android:layout_centerVertical="true" android:background="@drawable/circle_bg_dark" android:padding="10dp" android:src="@drawable/ic_events" app:tint="#666666" />
                    <LinearLayout android:layout_toEndOf="@id/iv_ev_icon" android:layout_marginStart="16dp" android:layout_centerVertical="true" android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content">
                        <TextView android:text="Manage Events" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:id="@+id/tv_event_count" android:text="Browse and moderate all events" android:textColor="#666666" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <ImageView android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron_right" app:tint="#333333" />
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- Manage Users Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/btn_manage_users"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="#121212"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">
                <RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent" android:paddingHorizontal="16dp">
                    <ImageView android:id="@+id/iv_user_icon" android:layout_width="40dp" android:layout_height="40dp" android:layout_centerVertical="true" android:background="@drawable/circle_bg_dark" android:padding="10dp" android:src="@drawable/ic_person" app:tint="#4CAF50" />
                    <LinearLayout android:layout_toEndOf="@id/iv_user_icon" android:layout_marginStart="16dp" android:layout_centerVertical="true" android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content">
                        <TextView android:text="Manage Users" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:id="@+id/tv_user_count" android:text="Moderate registered user profiles" android:textColor="#666666" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <ImageView android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron_right" app:tint="#333333" />
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- Manage Images Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/btn_manage_images"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="#121212"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">
                <RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent" android:paddingHorizontal="16dp">
                    <ImageView android:id="@+id/iv_img_icon" android:layout_width="40dp" android:layout_height="40dp" android:layout_centerVertical="true" android:background="@drawable/circle_bg_dark" android:padding="10dp" android:src="@android:drawable/ic_menu_gallery" app:tint="#666666" />
                    <LinearLayout android:layout_toEndOf="@id/iv_img_icon" android:layout_marginStart="16dp" android:layout_centerVertical="true" android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content">
                        <TextView android:text="Manage Images" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:text="Content moderation" android:textColor="#666666" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <ImageView android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron_right" app:tint="#333333" />
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- System Logs Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/btn_system_logs"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="#121212"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">
                <RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent" android:paddingHorizontal="16dp">
                    <ImageView android:id="@+id/iv_log_icon" android:layout_width="40dp" android:layout_height="40dp" android:layout_centerVertical="true" android:background="@drawable/circle_bg_dark" android:padding="10dp" android:src="@drawable/ic_info" app:tint="#666666" />
                    <LinearLayout android:layout_toEndOf="@id/iv_log_icon" android:layout_marginStart="16dp" android:layout_centerVertical="true" android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content">
                        <TextView android:text="System Logs" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:text="View activity and notification logs" android:textColor="#666666" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <ImageView android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron_right" app:tint="#333333" />
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- Entrant View Switcher -->
            <androidx.cardview.widget.CardView
                android:id="@+id/btn_entrant_view"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="#121212"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">
                <RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent" android:paddingHorizontal="16dp">
                    <ImageView android:id="@+id/iv_entrant_icon" android:layout_width="40dp" android:layout_height="40dp" android:layout_centerVertical="true" android:background="@drawable/circle_bg_dark" android:padding="10dp" android:src="@drawable/ic_person" app:tint="#666666" />
                    <LinearLayout android:layout_toEndOf="@id/iv_entrant_icon" android:layout_marginStart="16dp" android:layout_centerVertical="true" android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content">
                        <TextView android:text="Entrant" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:text="Join and participate in events" android:textColor="#666666" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <ImageView android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron_right" app:tint="#333333" />
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- Organizer View Switcher -->
            <androidx.cardview.widget.CardView
                android:id="@+id/btn_organizer_view"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="#121212"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">
                <RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent" android:paddingHorizontal="16dp">
                    <ImageView android:id="@+id/iv_org_icon" android:layout_width="40dp" android:layout_height="40dp" android:layout_centerVertical="true" android:background="@drawable/circle_bg_dark" android:padding="10dp" android:src="@drawable/ic_edit" app:tint="#666666" />
                    <LinearLayout android:layout_toEndOf="@id/iv_org_icon" android:layout_marginStart="16dp" android:layout_centerVertical="true" android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content">
                        <TextView android:text="Organizer" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:text="Create and manage events" android:textColor="#666666" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <ImageView android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron_right" app:tint="#333333" />
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <!-- Admin Bottom Nav -->
    <LinearLayout
        android:id="@+id/admin_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true"
        android:background="#0A0A0A"
        android:gravity="center"
        android:orientation="horizontal">
        <ImageView android:id="@+id/iv_dashboard_nav" android:layout_width="0dp" android:layout_height="24dp" android:layout_weight="1" android:src="@drawable/ic_explore" app:tint="#4CAF50" />
        <ImageView android:id="@+id/iv_add_nav" android:layout_width="0dp" android:layout_height="24dp" android:layout_weight="1" android:src="@drawable/ic_add" app:tint="#444444" />
        <ImageView android:id="@+id/iv_person_nav" android:layout_width="0dp" android:layout_height="24dp" android:layout_weight="1" android:src="@drawable/ic_person" app:tint="#444444" />
    </LinearLayout>

</RelativeLayout>