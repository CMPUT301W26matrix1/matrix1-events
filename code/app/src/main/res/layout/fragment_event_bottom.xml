    <LinearLayout
        android:id="@+id/bottom_nav_bar"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:background="#121212"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="8dp">

        <TextView
            android:id="@+id/nav_explore"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Explore"
            android:textColor="#7B61FF"
            android:textSize="10sp"
            android:drawableTop="@android:drawable/ic_menu_compass"
            app:drawableTint="#7B61FF" />

        <TextView
            android:id="@+id/nav_events"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:drawableTop="@android:drawable/ic_menu_today"
            android:gravity="center"
            android:text="Events"
            android:textColor="#888888"
            android:textSize="10sp"
            app:drawableTint="#888888" />

        <TextView
            android:id="@+id/nav_search"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Search..."
            android:textColor="#888888"
            android:textSize="10sp"
            android:drawableTop="@android:drawable/ic_menu_search"
            app:drawableTint="#888888" />

        <TextView
            android:id="@+id/nav_map"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Map"
            android:textColor="#888888"
            android:textSize="10sp"
            android:drawableTop="@android:drawable/ic_menu_mapmode"
            app:drawableTint="#888888" />

        <TextView
            android:id="@+id/nav_profile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Profile"
            android:textColor="#888888"
            android:textSize="10sp"
            android:drawableTop="@android:drawable/ic_menu_myplaces"
            app:drawableTint="#888888" />

    </LinearLayout>
</LinearLayout>