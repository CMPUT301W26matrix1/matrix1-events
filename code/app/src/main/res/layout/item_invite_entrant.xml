<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#121212"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="#1A1A1A"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- Entrant Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_entrant_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Full Name"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tv_entrant_email"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="email@example.com"
                android:textColor="#888888"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/tv_entrant_phone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Phone"
                android:textColor="#888888"
                android:textSize="13sp"/>

        </LinearLayout>

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <!-- Invite Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_invite"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="110dp"
                android:layout_height="38dp"
                android:text="Invite"
                android:textAllCaps="false"
                android:textColor="#000000"
                app:backgroundTint="#4CAF50"
                app:cornerRadius="20dp"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"/>

            <!-- Co-organizer Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_co_organizer"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="110dp"
                android:layout_height="38dp"
                android:text="Co-organizer"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                app:backgroundTint="#4D5DFA"
                app:cornerRadius="20dp"
                android:textSize="11sp"
                android:textStyle="bold"
                android:insetTop="0dp"
                android:insetBottom="0dp"/>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>