<?xml version="1.0" encoding="utf-8"?>
<HorizontalScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_reaction_picker"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp">

        <TextView
            android:id="@+id/tv_react_like"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="👍"
            android:textSize="24sp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tv_react_heart"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="❤️"
            android:textSize="24sp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tv_react_laugh"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="😂"
            android:textSize="24sp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tv_react_wow"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="😮"
            android:textSize="24sp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tv_react_sad"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="😢"
            android:textSize="24sp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tv_react_angry"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="😡"
            android:textSize="24sp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tv_react_clap"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="👏"
            android:textSize="24sp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tv_react_fire"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="🔥"
            android:textSize="24sp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>
</HorizontalScrollView>