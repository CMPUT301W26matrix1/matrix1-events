<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#E0E0E0">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingBottom="60dp">

            <!-- Message -->
            <TextView
                android:id="@+id/messageTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sorry, you weren't selected!"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#2C2C2C"
                android:layout_marginBottom="4dp"/>

            <!-- Event Name -->
            <TextView
                android:id="@+id/eventNameTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EVENT 2:"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#2C2C2C"
                android:layout_marginBottom="2dp"/>

            <!-- Details -->
            <TextView
                android:id="@+id/detailsTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Try again next time"
                android:textSize="14sp"
                android:textColor="#2C2C2C"
                android:layout_marginBottom="2dp"/>

            <!-- Time -->
            <TextView
                android:id="@+id/timestampTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="15 minutes ago"
                android:textSize="12sp"
                android:textColor="#616161"/>

        </LinearLayout>

        <!-- Button Container for ACCEPT and DECLINE -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp"
            android:layout_marginEnd="16dp">

            <!-- ACCEPT Button -->
            <Button
                android:id="@+id/acceptButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ACCEPT"
                android:textColor="#4CAF50"
                android:background="@android:color/transparent"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginEnd="2dp"
                android:visibility="gone"/>

            <!-- DECLINE Button -->
            <Button
                android:id="@+id/declineButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DECLINE"
                android:textColor="#F44336"
                android:background="@android:color/transparent"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone"/>


        </LinearLayout>

        <!-- Accepted Message (shows after accepting) -->
        <TextView
            android:id="@+id/acceptedMessageTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✓ You accepted this invitation"
            android:textColor="#4CAF50"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_gravity="bottom|end"
            android:layout_marginBottom="8dp"
            android:layout_marginEnd="16dp"
            android:visibility="gone"/>

        <!-- Declined Message (shows after declining) -->
        <TextView
            android:id="@+id/declinedMessageTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✗ You declined this invitation"
            android:textColor="#F44336"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_gravity="bottom|end"
            android:layout_marginBottom="8dp"
            android:layout_marginEnd="16dp"
            android:visibility="gone"/>

        <!-- Try Again Button -->
        <Button
            android:id="@+id/tryAgainButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TRY AGAIN"
            android:textColor="#6200EE"
            android:background="@android:color/transparent"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_gravity="bottom|end"
            android:layout_marginBottom="8dp"
            android:layout_marginEnd="16dp"
            android:visibility="gone"/>

    </FrameLayout>
</androidx.cardview.widget.CardView>