<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Internet permission -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Add these for location and maps -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- ADD THIS: Notification permission for Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="EventFlow"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.EventFlow">

        <!-- Google Maps API Key -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyBm028vGV2Wpc2LEACGkZvLXYAW8sx7Z8Q" />

        <!-- ADD THIS: Default notification icon -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />

        <!-- ADD THIS: Default notification color (optional) -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@android:color/holo_green_dark"/>

        <!-- ADD THIS: FCM Service -->
        <service
            android:name=".MyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <activity
            android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".LoginActivity"
            android:exported="false" />

        <activity
            android:name=".SignupActivity"
            android:exported="false" />

        <activity
            android:name=".RoleSelectionActivity"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="eventflow" />
            </intent-filter>
        </activity>

        <activity android:name=".NotificationsActivity" />
        <activity android:name=".BrowseEventsActivity" />
        <activity android:name=".ProfileActivity" />

        <!-- Waiting List Screen -->
        <activity android:name=".WaitingListActivity" />

        <activity android:name=".AdminDashboardActivity" android:label="Admin Panel" />
        <activity android:name=".AdminBrowseEventsActivity" />
        <activity android:name=".AdminManageEventsActivity" android:label="Manage Events" />

        <activity android:name=".view.profile.SelectedEntrantsActivity" />
        <activity android:name=".EventDetailActivity" />

        <!-- Create Event Organizer screen -->
        <activity
            android:name=".org_event.OrgEventActivity"
            android:label="Create Event" />

        <activity
            android:name=".org_event.EventDetailsActivity"
            android:exported="false" />

        <activity
            android:name=".org_QR.QRDisplayActivity"
            android:exported="false" />

        <activity android:name=".org_event.InviteEntrantsActivity" />

        <!-- Co-organizer Invitation Activity -->
        <activity
            android:name=".org_event.manage_entrant.CoOrganizerInvitationActivity"
            android:exported="false" />

        <!-- Manage Entrants - All activities in the same package -->
        <activity
            android:name=".org_event.manage_entrant.EntrantDashboardActivity"
            android:exported="false" />

        <activity
            android:name=".org_event.manage_entrant.WaitlistMgmtActivity"
            android:exported="false" />

        <activity
            android:name=".org_event.manage_entrant.CancelledEntrantsActivity"
            android:exported="false" />

        <activity
            android:name=".org_event.manage_entrant.OrganizerFinalEntrantsActivity"
            android:exported="false" />

        <activity
            android:name=".org_event.manage_entrant.EnrolledEntrantsActivity"
            android:exported="false" />

        <activity
            android:name=".org_event.manage_entrant.NotificationsActivity"
            android:exported="false" />

        <!-- Notification History Activity -->
        <activity
            android:name=".org_event.manage_entrant.NotificationHistoryActivity"
            android:exported="false"
            android:label="Notification History" />

        <!-- Organizer Notification Center Activity -->
        <activity
            android:name=".org_event.manage_entrant.OrganizerNotificationCenterActivity"
            android:exported="false"
            android:label="Notifications" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.example.eventflow.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Map Activity for viewing entrant locations -->
        <activity
            android:name=".EntrantLocationMapActivity"
            android:label="Entrant Locations" />

        <!-- Location Picker Activity -->
        <activity
            android:name=".LocationPickerActivity"
            android:label="Pick Location" />

        <!-- Admin Profile Management Activity -->
        <activity
            android:name=".AdminProfileListActivity"
            android:label="Manage Profiles" />

        <!--Manage Images -->
        <activity
            android:name=".AdminImageManagementActivity"
            android:label="Manage Images" />

        <!--Profile detail -->
        <activity
            android:name=".ProfileDetailActivity"
            android:label="Profile Details" />

        <activity
            android:name=".FullscreenImageActivity"
            android:theme="@style/Theme.AppCompat.NoActionBar" />

        <activity
            android:name=".AdminNotificationLogsActivity"
            android:label="Notification Logs" />

        <!-- Organizer Events List -->
        <activity
            android:name=".OrganizerEventsActivity"
            android:label="My Events" />

        <!-- Custom QR Scanner -->
        <activity
            android:name=".CustomScannerActivity"
            android:screenOrientation="portrait"
            android:stateNotNeeded="true"
            android:theme="@style/Theme.MaterialComponents.DayNight.NoActionBar"
            android:windowSoftInputMode="stateAlwaysHidden" />

    </application>

</manifest>