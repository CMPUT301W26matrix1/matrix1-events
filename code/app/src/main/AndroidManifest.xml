<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Internet permission (existing) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Add these for location and maps -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="EventFlow"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar">

        <!-- Add Google Maps API Key -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="YOUR_GOOGLE_MAPS_API_KEY" />

        <activity
            android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="true" />

        <activity android:name=".NotificationsActivity" />
        <activity android:name=".BrowseEventsActivity" />
        <activity android:name=".ProfileActivity" />

        <activity
            android:name=".OrganizerFinalEntrantsActivity"
            android:exported="false" />

        <!-- Waiting List Screen -->
        <activity android:name=".WaitingListActivity" />

        <activity android:name=".AdminBrowseEventsActivity" />
        <activity android:name=".view.profile.SelectedEntrantsActivity" />
        <activity android:name=".EventDetailActivity" />

        <!-- Create Event Organizer screen -->
        <activity
            android:name=".org_event.OrgEventActivity"
            android:label="Create Event" />

        <activity
            android:name=".org_event.EventDetailsActivity"
            android:exported="false" />

        <activity
            android:name=".org_QR.QRDisplayActivity"
            android:exported="false" />

        <activity android:name=".org_event.InviteEntrantsActivity" />

        <!-- Map Activity for viewing entrant locations -->
        <activity
            android:name=".EntrantLocationMapActivity"
            android:label="Entrant Locations" />

        <!-- NEW: Admin Profile Management Activity (US 03.01.01) -->
        <activity
            android:name=".AdminProfileListActivity"
            android:label="Manage Profiles" />

    </application>

</manifest>